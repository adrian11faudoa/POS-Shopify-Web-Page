# SnackPOS Environment Variables
# Copy this file to .env in each service/app directory and fill in values.
# NEVER commit .env files to source control.

# ═══════════════════════════════════════════════════════════
# services/api/.env
# ═══════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
TRUST_PROXY=1
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://snackpos:password@localhost:5432/snackpos
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_ACQUIRE_TIMEOUT=60000
DATABASE_POOL_IDLE_TIMEOUT=600000

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ─── JWT ──────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_min_32_chars_random_string_here
JWT_REFRESH_SECRET=CHANGE_ME_different_32_chars_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ─── Shopify ──────────────────────────────────────────────
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_API_VERSION=2024-01
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,write_customers,read_inventory,write_inventory,read_fulfillments,write_fulfillments,read_price_rules,write_price_rules

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ─── Email (Resend / SMTP) ────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=SnackPOS

# Alternatively, SMTP:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.mailhog.example
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=

# ─── Storage (Cloudflare R2 / S3) ─────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret
R2_BUCKET_NAME=snackpos-assets
R2_PUBLIC_URL=https://assets.yourdomain.com

# ─── Monitoring (Optional) ────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...
DATADOG_API_KEY=
NEW_RELIC_LICENSE_KEY=

# ═══════════════════════════════════════════════════════════
# apps/web/.env (Next.js Customer Storefront)
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STORE_ID=your_store_uuid
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# ═══════════════════════════════════════════════════════════
# apps/pos/.env (POS App)
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STORE_ID=your_store_uuid
NEXT_PUBLIC_POS_TERMINAL_ID=terminal_01
# Thermal printer endpoint (if using network printer)
NEXT_PUBLIC_PRINTER_URL=http://192.168.1.100:9100

# ═══════════════════════════════════════════════════════════
# apps/kds/.env (Kitchen Display)
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STORE_ID=your_store_uuid
NEXT_PUBLIC_KDS_TERMINAL_ID=kds_01

# ═══════════════════════════════════════════════════════════
# apps/admin/.env (Admin Dashboard)
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://localhost:4000

# ═══════════════════════════════════════════════════════════
# Production Secrets (use your secret manager)
# ═══════════════════════════════════════════════════════════
# For Kubernetes: use Sealed Secrets or External Secrets Operator
# For Railway/Render: use their secrets UI
# For AWS: use Secrets Manager or Parameter Store
# NEVER put production secrets in .env files committed to git
